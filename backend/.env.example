# Vrutti backend configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for extraction, fit evaluation, drafting, and reviewing.
# Override if you want to use a different Claude model.
CLAUDE_MODEL=claude-sonnet-5

# SQLite by default; swap for a Postgres URL when you outgrow it, e.g.
# postgresql+psycopg://user:password@localhost:5432/vrutti
DATABASE_URL=sqlite:///./vrutti.db

# Comma-separated list of origins allowed to call this API (your frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
