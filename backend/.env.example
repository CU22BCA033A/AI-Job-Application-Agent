# Vrutti backend configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Free API key from https://build.nvidia.com/ (NVIDIA NIM — no card required).
NVIDIA_API_KEY=nvapi-your-key-here

# Model used for extraction, fit evaluation, drafting, and reviewing.
# Must support forced tool/function calling — verify on build.nvidia.com
# before switching; not every model in the catalog does. A smaller/faster
# model trades some quality for speed here — fine for these latency-
# sensitive calls, but see NVIDIA_MODEL_RESUME_PARSE below.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Model used specifically for resume parsing — a much harder one-shot
# extraction task (a large nested profile schema) than the other calls
# above, where a small/fast model tends to silently under-extract rather
# than fail loudly. Runs once per profile import, not per request, so it's
# worth keeping this on a larger model even if NVIDIA_MODEL above is set to
# something faster. Defaults to the same model as NVIDIA_MODEL if unset.
NVIDIA_MODEL_RESUME_PARSE=meta/llama-3.3-70b-instruct

# OpenAI-compatible base URL. Only change this if you're pointing at a
# different OpenAI-compatible provider instead of NVIDIA NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SQLite by default; swap for a Postgres URL when you outgrow it, e.g.
# postgresql+psycopg://user:password@localhost:5432/vrutti
DATABASE_URL=sqlite:///./vrutti.db

# Comma-separated list of origins allowed to call this API (your frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
