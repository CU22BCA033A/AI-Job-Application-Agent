# Vrutti backend configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Free API key from https://build.nvidia.com/ (NVIDIA NIM — no card required).
NVIDIA_API_KEY=nvapi-your-key-here

# Model used for extraction, fit evaluation, drafting, and reviewing.
# Must support forced tool/function calling — verify on build.nvidia.com
# before switching; not every model in the catalog does.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI-compatible base URL. Only change this if you're pointing at a
# different OpenAI-compatible provider instead of NVIDIA NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SQLite by default; swap for a Postgres URL when you outgrow it, e.g.
# postgresql+psycopg://user:password@localhost:5432/vrutti
DATABASE_URL=sqlite:///./vrutti.db

# Comma-separated list of origins allowed to call this API (your frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
